<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonDrawerGlobalSearch"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/drawer_global_search_label"
            app:icon="@drawable/ic_search"
            app:iconGravity="textStart" />

        <include
            android:id="@+id/drawerAppearanceHeader"
            layout="@layout/item_drawer_section" />

        <LinearLayout
            android:id="@+id/drawerAppearanceContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/labelAppBackground"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/drawer_app_background"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle2" />

            <ImageView
                android:id="@+id/imageAppBackgroundPreview"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="12dp"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_app_cosmic_flow"
                android:contentDescription="@string/drawer_app_background_preview_desc" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/drawer_app_background_presets"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />

            <GridLayout
                android:id="@+id/appBackgroundPresets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:columnCount="3"
                android:orientation="horizontal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDrawerPickAppBackground"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/drawer_pick_app_background"
                app:icon="@android:drawable/ic_menu_gallery"
                app:iconGravity="textStart" />

            <TextView
                android:id="@+id/labelCardBackgrounds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/drawer_card_backgrounds"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle2" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/drawerRecyclerImages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDrawerAddImages"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/drawer_add_images" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDrawerResetAppBackground"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/drawer_reset_app_background" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDrawerClearImages"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/drawer_clear_images" />
        </LinearLayout>

        <include
            android:id="@+id/drawerReadingHeader"
            layout="@layout/item_drawer_section" />

        <LinearLayout
            android:id="@+id/drawerReadingContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/labelCardFontSize"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/drawer_card_font_size"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Body1" />

                <TextView
                    android:id="@+id/textCardFontSizeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderCardFontSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:valueFrom="14"
                android:valueTo="26"
                android:stepSize="1" />

            <TextView
                android:id="@+id/labelCardFont"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/drawer_card_font"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle2" />

            <TextView
                android:id="@+id/textCardFontName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDrawerPickFont"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/drawer_pick_font_file" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDrawerVideoMute"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/drawer_video_mute" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDrawerResetFont"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/drawer_reset_font" />
        </LinearLayout>

        <include
            android:id="@+id/drawerSyncHeader"
            layout="@layout/item_drawer_section" />

        <LinearLayout
            android:id="@+id/drawerSyncContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/labelNotificationFrequency"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/drawer_notification_frequency"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Body1" />

                <TextView
                    android:id="@+id/textNotificationFrequencyValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderNotificationFrequency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:valueFrom="0"
                android:valueTo="60"
                android:stepSize="1" />

            <TextView
                android:id="@+id/labelWatchSync"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/drawer_watch_sync_title"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDrawerToggleWatchSync"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/drawer_watch_sync_enable" />

            <TextView
                android:id="@+id/textDrawerWatchSyncStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/drawer_watch_sync_status_loading"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />

            <TextView
                android:id="@+id/textDrawerWatchSyncEndpoint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/drawer_watch_sync_endpoint_loading"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Caption" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDrawerCopyWatchEndpoint"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/drawer_watch_sync_copy_endpoint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDrawerWatchSyncHelp"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/drawer_watch_sync_how_to_use" />
        </LinearLayout>

        <include
            android:id="@+id/drawerDataHeader"
            layout="@layout/item_drawer_section" />

        <LinearLayout
            android:id="@+id/drawerDataContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDrawerImportNotes"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/drawer_import_notes" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDrawerExportNotes"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/drawer_export_notes" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDrawerExportStickyNotes"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/drawer_export_sticky_notes" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
