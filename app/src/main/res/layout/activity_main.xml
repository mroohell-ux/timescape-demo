<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:background="@drawable/bg_app_cosmic_flow">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:translationZ="8dp"
            android:stateListAnimator="@null"
            app:elevation="0dp"
            app:liftOnScroll="false">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                android:stateListAnimator="@null"
                android:elevation="0dp"
                app:backgroundTint="@android:color/transparent"
                app:title="@string/app_name"
                app:titleCentered="false"
                app:titleTextColor="#FFFFFF"
                app:navigationIconTint="#FFFFFF"
                app:menu="@menu/menu_main"/>
        </com.google.android.material.appbar.AppBarLayout>

        <FrameLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/flowPager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"/>
        </FrameLayout>

        <com.example.timescapedemo.FlowDockView
            android:id="@+id/flowBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_margin="12dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:contentPadding="4dp"
            app:cardPreventCornerOverlap="false"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:id="@+id/flowDockRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                    <com.example.timescapedemo.FlowDockScrollView
                        android:id="@+id/flowChipScroll"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:overScrollMode="never"
                        android:requiresFadingEdge="horizontal"
                        android:fadingEdgeLength="18dp"
                        android:scrollbars="none">

                        <com.example.timescapedemo.FlowDockChipGroup
                            android:id="@+id/flowChips"
                            android:clipChildren="false"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            app:singleLine="true"
                            app:singleSelection="true"
                            app:selectionRequired="true"/>
                    </com.example.timescapedemo.FlowDockScrollView>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:importantForAccessibility="no"
                        android:background="#26D8F2FF"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonFlowLibrary"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:padding="12dp"
                        android:contentDescription="@string/flow_library_button"
                        android:tooltipText="@string/flow_library_button"
                        app:backgroundTint="@android:color/transparent"
                        app:cornerRadius="24dp"
                        app:icon="@drawable/ic_flow_grid"
                        app:iconTint="@color/flow_dock_text"
                        app:iconSize="20dp"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"/>

            </LinearLayout>

            <TextView
                android:id="@+id/flowDragHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/bg_flow_dock_hint"
                android:singleLine="true"
                android:ellipsize="end"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone"/>
        </com.example.timescapedemo.FlowDockView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/drawer_backgrounds"/>

</androidx.drawerlayout.widget.DrawerLayout>
