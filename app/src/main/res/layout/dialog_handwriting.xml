<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_handwriting_dialog_surface"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHandwritingToolbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/handwriting_toolbar_surface"
                app:cardCornerRadius="28dp"
                app:cardElevation="8dp"
                app:cardUseCompatPadding="true"
                app:strokeColor="@color/handwriting_toolbar_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="6dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonUndoHandwriting"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@string/handwriting_action_undo"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        app:cornerRadius="20dp"
                        app:icon="@drawable/ic_handwriting_undo"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="21dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonClearHandwriting"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="2dp"
                        android:contentDescription="@string/handwriting_action_clear"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        app:cornerRadius="20dp"
                        app:icon="@drawable/ic_handwriting_clear"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="21dp" />


                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonInsertPictureHandwriting"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="2dp"
                        android:contentDescription="@string/handwriting_action_insert_picture"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        app:cornerRadius="20dp"
                        app:icon="@drawable/ic_gallery"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="21dp" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@color/handwriting_toolbar_divider" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/groupPaletteToggles"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        app:selectionRequired="false"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonPenOptions"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="42dp"
                            android:layout_height="40dp"
                            android:contentDescription="@string/handwriting_tool_pen"
                            android:checkable="true"
                            android:minWidth="0dp"
                            android:padding="0dp"
                            app:cornerRadius="20dp"
                            app:icon="@drawable/ic_handwriting_pen"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="21dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonEraserOptions"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="42dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="2dp"
                            android:contentDescription="@string/handwriting_tool_eraser"
                            android:checkable="true"
                            android:minWidth="0dp"
                            android:padding="0dp"
                            app:cornerRadius="20dp"
                            app:icon="@drawable/ic_handwriting_eraser"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="21dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonTextInsert"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="42dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="2dp"
                            android:contentDescription="@string/handwriting_tool_text"
                            android:checkable="true"
                            android:minWidth="0dp"
                            android:padding="0dp"
                            app:cornerRadius="20dp"
                            app:icon="@drawable/ic_edit"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="21dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonCanvasOptions"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="42dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="2dp"
                            android:contentDescription="@string/handwriting_tool_canvas"
                            android:checkable="true"
                            android:minWidth="0dp"
                            android:padding="0dp"
                            app:cornerRadius="20dp"
                            app:icon="@drawable/ic_handwriting_paper"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="21dp" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHandwritingCanvas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                app:cardBackgroundColor="@color/handwriting_paper_default"
                app:cardCornerRadius="24dp"
                app:cardElevation="7dp"
                app:cardUseCompatPadding="true"
                app:strokeColor="@android:color/transparent"
                app:strokeWidth="0dp">

                <com.example.timescapedemo.HandwritingView
                    android:id="@+id/handwritingView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/handwriting_card_content_desc"
                    android:importantForAccessibility="no"
                    android:minHeight="360dp" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/barHandwritingActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_handwriting_action_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="18dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonDeleteHandwriting"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="@string/dialog_delete"
            android:minWidth="0dp"
            android:padding="0dp"
            android:visibility="gone"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_handwriting_clear"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:iconTint="@color/handwriting_text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonCancelHandwriting"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@android:string/cancel"
            android:textAllCaps="false"
            android:textColor="@color/handwriting_text_secondary"
            android:textSize="15sp"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonDoneHandwriting"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1.35"
            android:text="@string/dialog_done"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:backgroundTint="@color/handwriting_accent"
            app:cornerRadius="22dp" />
    </LinearLayout>
</LinearLayout>
