<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="2dp" />
            <solid android:color="@android:color/transparent" />
            <stroke android:width="3dp" android:color="#4859CFFF" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape>
            <corners android:radius="1dp" />
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="#DCF0FAFF" />
        </shape>
    </item>
    <item android:height="1dp" android:gravity="top" android:left="4dp" android:right="4dp">
        <shape>
            <gradient android:angle="0" android:startColor="#30FFFFFF" android:centerColor="#FFFFFFFF" android:endColor="#80FFFFFF" />
        </shape>
    </item>
</layer-list>
